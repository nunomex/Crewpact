{
  "expo": {
    "name": "CrewPact",
    "slug": "crewpact",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.crewpact.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.crewpact.app"
    },
    "scheme": "crewpact",
    "plugins": [
      [
        "expo-calendar",
        {
          "calendarPermission": "A CrewPact lê a tua escala do calendário para mostrar o próximo voo, folgas e pernoitas."
        }
      ],
      "expo-localization"
    ]
  }
}
