node_modules
.env
.expo
dist
*.log

# Native (CNG) — geradas pelo prebuild/expo run, não versionar
/android
/ios

# Claude Code — config pessoal/por-máquina (permissões auto-aprovadas, paths locais).
# São específicas do utilizador/máquina, não config partilhada → não versionar.
.claude/settings.json
.claude/settings.local.json

# Referências de design (capturas de outras apps, do Mobbin) — só neste PC, não vão para o GitHub.
# O índice com os links (referencias/**/README.md) é versionado.
referencias/**/*.webp
referencias/**/*.png
referencias/**/*.jpg

# Fontes oficiais: o PDF do BTE fica no PC (identificado por SHA-256 em fontes/README.md); o texto
# extraído (.txt) é versionado — o teste das citações confere cada regra contra ele.
fontes/**/*.pdf

# Capturas do navegador de teste (Playwright MCP)
.playwright-mcp/
